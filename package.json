{
  "name": "cabbage-memory",
  "version": "2.0.0",
  "description": "Monorepo for the cabbage-memory plugin, its Cloudflare Workers backend and web dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @devcxl/cabbage-memory build",
    "build:web": "pnpm --filter @devcxl/cabbage-memory-web build",
    "dev": "pnpm --filter @devcxl/cabbage-memory dev",
    "dev:api": "pnpm --filter @devcxl/cabbage-memory-api dev",
    "deploy:api": "pnpm --filter @devcxl/cabbage-memory-api deploy",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"apps/plugin/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/plugin/src/**/*.ts\"",
    "prepare": "husky"
  },
  "license": "MIT",
  "devDependencies": {
    "hono": "^4.12.0",
    "husky": "^9.1.7",
    "jose": "^5.10.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0"
  }
}
